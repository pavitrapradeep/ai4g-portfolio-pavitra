    {
      "parameters": {
        "jsCode": "const LF = String.fromCharCode(10);\n// All rows returned for this user; keep only the 7 most recent (assumed appended chronologically).\nconst rows = $input.all().map(i => i.json).filter(r => Object.keys(r).length > 0);\nconst recent = rows.slice(-7);\nconst lines = recent.map(r => 'Date: ' + r.Date + ' | Mood: ' + r.MoodScore + '/10 | Stress: ' + r.StressScore + '/10 | Note: ' + r.Entry);\n\n// The current submission is carried from the Prepare Entry node.\nconst today = $(\"Prepare Entry\").first().json;\n\nreturn [{ json: {\n  Email: today.Email,\n  Name: today.Name,\n  MoodScore: today.MoodScore,\n  StressScore: today.StressScore,\n  Entry: today.Entry,\n  previousEntries: lines.join(LF),\n} }];"
      },
      "id": "6897ea20-f143-4547-a5b0-5f7c2815ce9f",
      "name": "Format History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today's entry:\nMood score: {{ $json.MoodScore }}/10\nStress score: {{ $json.StressScore }}/10\nWhat happened: {{ $json.Entry }}\n\nPrevious entries (oldest first):\n{{ $json.previousEntries }}\n\nRespond with the JSON structure described in your instructions.",
        "messages": {
          "messageValues": [
            {
              "message": "You are a supportive, non-judgmental wellbeing assistant helping someone reflect on their day through a journaling app. Read the user's current entry together with their recent past entries. Write a short, warm reflection of 2-3 sentences. Gently note any recurring pattern you observe across multiple entries, for example repeated stress about work, sleep or relationships — only mention a pattern if there is real evidence across several entries, never invent one. Suggest one small, concrete, realistic action. Finally assess a stressAlert level of low, medium or high. Use high only when there are clear signs of ongoing serious distress, hopelessness, or language suggesting the person may be unsafe. Be conservative, but do not miss genuine warning signs. Respond ONLY with valid JSON, with no text before or after it, in exactly this structure: {\"reflection\": \"\", \"pattern\": \"\", \"tip\": \"\", \"stressAlert\": \"\"}"
            }
          ]
        },
        "batching": {}
      },
      "id": "3ae11642-235d-4cdb-9384-1663306e56c0",
      "name": "Generate Reflection",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
