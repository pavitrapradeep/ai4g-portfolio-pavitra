      "id": "46b75ea7-9df3-4405-b51d-ea2db93b0825",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1200,
        336
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const history = $(\"Format History\").first().json;\nlet aiText = $input.first().json.text || \"\";\n\n// Strip any markdown code fences the model may have added.\nconst FENCE = String.fromCharCode(96);\nlet cleaned = String(aiText).replace(new RegExp(FENCE + '{3}' + '(json)?', 'gi'), '').replace(new RegExp(FENCE + '{3}', 'g'), '').trim();\n\nlet out;\ntry {\n  const parsed = JSON.parse(cleaned);\n  out = {\n    reflection: parsed.reflection || \"\",\n    pattern: parsed.pattern || \"\",\n    tip: parsed.tip || \"\",\n    stressAlert: String(parsed.stressAlert || \"low\").toLowerCase(),\n  };\n} catch (e) {\n  out = {\n    reflection: \"Thank you for checking in today. We could not generate a full reflection this time, but your entry has been saved safely.\",\n    pattern: \"\",\n    tip: \"Take a slow breath and be kind to yourself today.\",\n    stressAlert: \"low\",\n  };\n}\n\nout.Email = history.Email;\nout.Name = history.Name;\n\nreturn [{ json: out }];"
      },
