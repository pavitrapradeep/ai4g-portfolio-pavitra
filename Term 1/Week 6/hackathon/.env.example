# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without a key the NVD API still works, at 5 requests per 30 seconds.
NVD_API_KEY=

# Sent as User-Agent so a server admin can reach us. Use a team contact address.
CONTACT=
